  "scripts": {
    "dev": "pnpm nx run-many --target=build --projects=tag:type:domain && pnpm nx run-many --target=serve --projects=pos-client,api-edge --parallel",
    "start": "nx serve pos-client",
    "db:migrate": "TS_NODE_PROJECT=apps/api-edge/tsconfig.migrations.json knex --knexfile apps/api-edge/knexfile.ts migrate:latest",
    "icons:build": "node tools/phosphor/build-icons.mjs",
    "db:create": "TS_NODE_PROJECT=apps/api-edge/tsconfig.migrations.json knex --knexfile apps/api-edge/knexfile.ts migrate:make",
    "tauri:dev": "cd apps/pos-client && tauri dev",
    "tauri:build": "cd apps/pos-client && tauri build",
    "android:build": "bash tools/scripts/android-apk.sh build",
    "android:install": "bash tools/scripts/android-apk.sh install",
    "android:run": "bash tools/scripts/android-apk.sh run",
    "admin:dev": "nx serve admin-client",
    "admin:build": "nx build admin-client --configuration=production",
    "version:bump": "node tools/scripts/bump-version.mjs",
    "release:verify": "node --test tools/scripts/bump-version.spec.mjs",
    "docker:build": "bash tools/docker/build-edge.sh",
    "docker:release": "bash tools/docker/build-edge.sh --push",
    "release": "bash tools/scripts/release-tag.sh --push",
    "release:edge": "bash tools/scripts/release-tag.sh --type edge --push",
    "release:pos-client": "bash tools/scripts/release-tag.sh --type pos-client --push",
    "audit:pos-px": "node tools/pos-px-audit.mjs",
    "docs:log": "node scripts/docs-log.mjs",
    "docs:log:check": "node scripts/docs-log.mjs --check",
    "docs:adr:index": "node scripts/docs-adr-index.mjs",
    "docs:adr:index:check": "node scripts/docs-adr-index.mjs --check",
    "docs:adr:next": "node scripts/docs-adr-index.mjs --next",
    "empty-targets:gate": "node scripts/empty-test-targets.mjs",
    "empty-targets:gate:update": "node scripts/empty-test-targets.mjs --update",
    "targets:overrides:gate": "node scripts/inferred-target-overrides.mjs",
    "targets:uncached:gate": "node scripts/uncached-targets.mjs",
    "csp:gate": "node scripts/csp-connect-src.mjs",
    "android-xml:gate": "node scripts/android-xml-gate.mjs",
    "pos-gedankenstrich:gate": "node scripts/pos-gedankenstrich-gate.mjs",
    "vitest-helper:gate": "node scripts/vitest-helper-gate.mjs",
    "tailwind:gate": "node scripts/tailwind-source-gate.mjs",
    "targets:uncached:gate:update": "node scripts/uncached-targets.mjs --update",
    "security:install": "bash scripts/install-security-tools.sh",
    "security:scan": "node scripts/security-scan.mjs --mode=local",
    "security:report": "node scripts/security-scan.mjs --mode=all --report",
    "prepare": "lefthook install || true"
  },
