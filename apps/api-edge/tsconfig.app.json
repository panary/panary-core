{
  // Erbt von tsconfig.json (Solution-Config) statt direkt von tsconfig.base.json —
  // damit gilt `rootDir: .` aus der Basis, also der Workspace-Root. Das frueher
  // hier gesetzte `rootDir: ./src` war mit dem typecheck-Target unvereinbar:
  // `tsc --build` folgt den `@panary/*`-Importen nach libs/, die dann ausserhalb
  // von rootDir lagen (146x TS6059). Auf die Build-Ausgabe wirkt es nicht —
  // @nx/esbuild bestimmt die Struktur ueber outputPath/outbase, nicht ueber
  // rootDir; die Ausgabe liegt vorher wie nachher unter apps/api-edge/src/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "files": ["src/main.ts"],
  "include": ["src/**/*.ts"],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "test/**/*.ts"]
}
