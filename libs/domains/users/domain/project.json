{
  "name": "users-domain",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domains/users/domain/src",
  "projectType": "library",
  "tags": ["type:domain", "domain:users"],
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": ["{workspaceRoot}/libs/domains/users/domain/dist"],
      "dependsOn": ["^build"],
      "options": {
        "outputPath": "libs/domains/users/domain/dist",
        "project": "libs/domains/users/package.json",
        "tsConfig": "libs/domains/users/domain/tsconfig.lib.json",
        "main": "libs/domains/users/domain/src/index.ts",
        "format": ["cjs"],
        "external": ["@feathersjs/feathers", "@feathersjs/typebox", "@sinclair/typebox", "@panary/shared-common"],
        "generatePackageJson": false,
        "compiler": "tsc"
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        { "json": "{workspaceRoot}/tsconfig.json", "fields": ["compilerOptions"] },
        { "externalDependencies": ["vitest"] },
        { "env": "CI" },
        { "dependentTasksOutputFiles": "**/*.js", "transitive": true },
        "{workspaceRoot}/docs/security/rollen-matrix.md",
        { "env": "ROLLEN_MATRIX_SCHREIBEN" }
      ]
    }
  }
}
